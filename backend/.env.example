DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbearia?schema=public"

# SEGURANCA: gere segredos aleatorios fortes (>= 32 caracteres).
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em producao o servidor NAO sobe com segredos fracos/ausentes (fail secure).
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
NODE_ENV="development"
PORT=3333

# IMPORTANTE: fuso da barbearia. Servidores de producao rodam em UTC;
# sem isto os horarios aparecem deslocados para o cliente.
TIMEZONE="America/Sao_Paulo"

SLOT_INTERVAL_MINUTES=45
# Antecedencia minima para o cliente conseguir agendar (em minutos).
MINIMUM_BOOKING_NOTICE_MINUTES=15

# Atras de proxy reverso (Nginx/CDN) em producao, mantenha true para IP real no rate-limit/auditoria.
TRUST_PROXY="false"

# Reset de senha (token de recuperacao). Envio de e-mail e apenas logado em dev (EMAIL_TRANSPORT=log).
PASSWORD_RESET_EXPIRES_MINUTES=30
EMAIL_TRANSPORT="log"
EMAIL_FROM="Barbearia Prime <no-reply@barbearia.local>"

# Preparado para Google OAuth futuro (deixe vazio por enquanto).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
