# =============================================================================
# BANCO DE DADOS
# =============================================================================
# Local (PostgreSQL embarcado):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbearia?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/barbearia?schema=public"

# Producao (Supabase):
#   DATABASE_URL -> Connection pooling (porta 6543) + ?pgbouncer=true
#   DIRECT_URL   -> Conexao direta (porta 5432), usada apenas pelas migracoes
# DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# =============================================================================
# SEGURANCA
# =============================================================================
# Gere segredos aleatorios fortes (>= 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em producao o servidor NAO sobe com segredos fracos/ausentes (fail secure).
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Origens autorizadas (CORS/CSRF), separadas por virgula, sem barra no final.
# Producao: https://SEU-PROJETO.vercel.app,https://seudominio.com.br
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

NODE_ENV="development"
PORT=3333

# Atras de proxy reverso (Railway, Nginx, CDN): true para IP real no rate-limit/auditoria.
TRUST_PROXY="false"

# =============================================================================
# ARMAZENAMENTO DE IMAGENS (Cloudinary)
# =============================================================================
# Obrigatorio em producao: o disco do container e apagado a cada deploy.
# Credenciais em cloudinary.com > Dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="barbearia"

# =============================================================================
# REGRAS DE NEGOCIO
# =============================================================================
# Fuso da barbearia. Servidores de producao rodam em UTC;
# sem isto os horarios aparecem deslocados para o cliente.
TIMEZONE="America/Sao_Paulo"

SLOT_INTERVAL_MINUTES=45
MINIMUM_BOOKING_NOTICE_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=30

# =============================================================================
# E-MAIL
# =============================================================================
# "log" apenas registra no console. Troque por um provedor real quando houver credenciais.
EMAIL_TRANSPORT="log"
EMAIL_FROM="Barbearia Prime <no-reply@barbearia.local>"

# =============================================================================
# OPCIONAL
# =============================================================================
# Preparado para Google OAuth futuro (deixe vazio por enquanto).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
