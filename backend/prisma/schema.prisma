generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDENTE
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

model Barber {
  id             String          @id @default(uuid())
  shopName       String          @default("Barbearia Prime")
  whatsappNumber String          @default("5511999999999")
  admins         Admin[]
  services       Service[]
  availabilities Availability[]
  blocks         ScheduleBlock[]
  appointments   Appointment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  barberId     String   @map("barbeiro_id")
  barber       Barber   @relation(fields: [barberId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Service {
  id                  String               @id @default(uuid())
  barberId            String               @map("barbeiro_id")
  barber              Barber               @relation(fields: [barberId], references: [id])
  name                String
  description         String
  priceCents          Int
  estimatedMinutes    Int
  active              Boolean              @default(true)
  appointmentServices AppointmentService[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Availability {
  id        String   @id @default(uuid())
  barberId  String   @map("barbeiro_id")
  barber    Barber   @relation(fields: [barberId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barberId, dayOfWeek])
}

model ScheduleBlock {
  id        String   @id @default(uuid())
  barberId  String   @map("barbeiro_id")
  barber    Barber   @relation(fields: [barberId], references: [id])
  date      DateTime
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())
}

model Client {
  id           String        @id @default(uuid())
  name         String
  phone        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id                  String               @id @default(uuid())
  barberId            String               @map("barbeiro_id")
  barber              Barber               @relation(fields: [barberId], references: [id])
  clientId            String
  client              Client               @relation(fields: [clientId], references: [id])
  startAt             DateTime
  endAt               DateTime
  status              AppointmentStatus    @default(PENDENTE)
  totalPriceCents     Int
  totalMinutes        Int
  appointmentServices AppointmentService[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([barberId, startAt, endAt])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  priceCents    Int
  minutes       Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}
