# Endereco da API, sempre terminando em /api e sem barra no final.
# Local:
VITE_API_URL="http://localhost:3333/api"

# Producao (Railway):
# VITE_API_URL="https://SEU-BACKEND.up.railway.app/api"

# Google OAuth (opcional - Google Identity Services)
# Obtenha em https://console.cloud.google.com/apis/credentials
# Crie um "ID do cliente OAuth 2.0" do tipo "Aplicativo Web"
# Origens autorizadas JavaScript: http://localhost:5173, https://SEU-DOMINIO.vercel.app
VITE_GOOGLE_CLIENT_ID=""
